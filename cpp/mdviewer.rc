#include <winver.h>
1 ICON "../build/icon.ico"
1 24 "mdviewer.manifest"
1 VERSIONINFO
 FILEVERSION 1,4,1,0
 PRODUCTVERSION 1,4,1,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Soumyakanta Bera"
      VALUE "FileDescription", "MD Viewer"
      VALUE "FileVersion", "1.4.1"
      VALUE "InternalName", "mdviewer"
      VALUE "LegalCopyright", "Copyright (c) 2026 Soumyakanta Bera"
      VALUE "OriginalFilename", "mdviewer.exe"
      VALUE "ProductName", "MD Viewer"
      VALUE "ProductVersion", "1.4.1"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
